@model IEnumerable<BhuttaBoutiqueERP.Models.Production.Entities.DemandAllocation>

@{
    ViewData["Title"] = "Demand List";
}

<!-- Sticky Header Strip -->
<div class="sticky-header-strip">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h3 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                <i class="fas fa-list-check text-primary"></i> Demand List
            </h3>
            <p class="text-secondary small mb-0">View and manage all fabric demands across production orders.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Pending")" class="btn btn-outline-warning px-3 rounded-pill shadow-sm" style="font-weight: 600;">
                <i class="fas fa-clock me-1"></i> Pending
            </a>
            <button type="button" class="btn btn-primary px-4 rounded-pill shadow-sm open-modal-btn" data-url="@Url.Action("Create")">
                <i class="fas fa-plus me-1"></i> New Demand
            </button>
        </div>
    </div>
</div>

<!-- Main Content Card -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive sticky-table-wrap">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary text-uppercase fs-7">
                    <tr>
                        <th class="ps-4">Order #</th>
                        <th>Item</th>
                        <th>Demand Qty</th>
                        <th>Allocated Qty</th>
                        <th>Status</th>
                        <th>Date</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4"><span class="fw-semibold text-dark">@item.Order?.OrderNumber</span></td>
                                <td>@item.Item?.Name</td>
                                <td>@item.DemandQuantity.ToString("0.##")</td>
                                <td>@item.AllocatedQuantity.ToString("0.##")</td>
                                <td>
                                    <span class="badge @(item.Status == "Completed" ? "bg-success" : item.Status == "Allocated" ? "bg-info" : "bg-warning text-dark") rounded-pill px-2">
                                        @item.Status
                                    </span>
                                </td>
                                <td>@item.Date.ToString("dd MMM yyyy")</td>
                                <td class="text-end pe-4">
                                    <a href="@Url.Action("ByOrder", new { orderId = item.OrderId })" class="btn btn-sm btn-outline-primary" title="View by Order">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-5">
                                <i class="fas fa-inbox fa-3x d-block mb-2 opacity-25"></i>
                                <p class="mb-0 fw-medium">No demands found.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>