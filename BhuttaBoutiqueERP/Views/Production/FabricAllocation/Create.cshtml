@model BhuttaBoutiqueERP.Models.Production.ViewModels.FabricAllocationViewModel

<div class="modal-dialog modal-lg">
    <div class="modal-content">
        <div class="modal-header bg-light">
            <h5 class="modal-title text-dark fw-bold" style="font-size: 16px;">
                <i class="fas fa-plus-circle me-2 text-primary"></i>New Fabric Allocation
            </h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <form asp-action="Create" method="post" class="ajax-form">
            <div class="modal-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="DemandId" class="form-label"></label>
                        <select asp-for="DemandId" class="form-select" asp-items="@(new SelectList(ViewBag.Demands, "Id", "Order.OrderNumber"))">
                            <option value="">-- Select Demand --</option>
                        </select>
                        <span asp-validation-for="DemandId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="AllocatedQuantity" class="form-label"></label>
                        <input asp-for="AllocatedQuantity" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="AllocatedQuantity" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Remarks" class="form-label"></label>
                        <textarea asp-for="Remarks" class="form-control" rows="2" placeholder="Allocation notes"></textarea>
                        <span asp-validation-for="Remarks" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary px-4" style="font-weight: 600;">
                    <i class="fas fa-save me-1"></i> Allocate
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}