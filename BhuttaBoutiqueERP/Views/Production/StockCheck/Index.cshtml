@model IEnumerable<BhuttaBoutiqueERP.Models.Production.ViewModels.StockCheckViewModel>

@{
    ViewData["Title"] = "Stock Check";
}

<!-- Sticky Header Strip -->
<div class="sticky-header-strip">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h3 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                <i class="fas fa-warehouse text-primary"></i> Stock Check
            </h3>
            <p class="text-secondary small mb-0">Check fabric availability and stock levels for production demands.</p>
        </div>
    </div>
</div>

<!-- Main Content Card -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive sticky-table-wrap">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary text-uppercase fs-7">
                    <tr>
                        <th class="ps-4">Code</th>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Current Stock</th>
                        <th>Available Stock</th>
                        <th class="pe-4">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            var isLowStock = item.AvailableStock <= item.ReorderLevel;
                            <tr>
                                <td class="ps-4"><span class="fw-semibold text-dark">@item.Code</span></td>
                                <td>@item.Name</td>
                                <td><span class="badge bg-light text-dark border">@item.Category</span></td>
                                <td>@item.Stock.ToString("0.##")</td>
                                <td>
                                    <span class="fw-bold @(item.AvailableStock <= 0 ? "text-danger" : isLowStock ? "text-warning" : "text-success")">
                                        @item.AvailableStock.ToString("0.##")
                                    </span>
                                </td>
                                <td class="pe-4">
                                    @if (item.AvailableStock <= 0)
                                    {
                                        <span class="badge bg-danger text-white rounded-pill px-2">Out of Stock</span>
                                    }
                                    else if (isLowStock)
                                    {
                                        <span class="badge bg-warning text-dark rounded-pill px-2">Low Stock</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success text-white rounded-pill px-2">Available</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-5">
                                <i class="fas fa-inbox fa-3x d-block mb-2 opacity-25"></i>
                                <p class="mb-0 fw-medium">No items found.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>