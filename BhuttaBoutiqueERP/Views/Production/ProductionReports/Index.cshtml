@model BhuttaBoutiqueERP.Models.Production.ViewModels.ProductionReportViewModel

@{
    ViewData["Title"] = "Production Reports";
}

<!-- Sticky Header Strip -->
<div class="sticky-header-strip">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h3 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                <i class="fas fa-chart-line text-primary"></i> Production Reports
            </h3>
            <p class="text-secondary small mb-0">Real-time production analytics, stage-wise tracking, and performance metrics.</p>
        </div>
        <a href="@Url.Action("Details")" class="btn btn-outline-primary px-4 rounded-pill shadow-sm">
            <i class="fas fa-eye me-1"></i> View Details
        </a>
    </div>
</div>

<!-- Widgets Row -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card p-3 shadow-sm h-100 border-start border-primary border-4">
            <div class="d-flex justify-content-between align-items-center">
                <span class="text-secondary fw-semibold small text-uppercase">Total in Production</span>
                <i class="fas fa-industry fa-2x text-primary opacity-50"></i>
            </div>
            <div class="fs-3 fw-bold text-dark mt-2 font-monospace">@Model.TotalOrdersInProduction</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card p-3 shadow-sm h-100 border-start border-warning border-4">
            <div class="d-flex justify-content-between align-items-center">
                <span class="text-secondary fw-semibold small text-uppercase">Pending Orders</span>
                <i class="fas fa-clock fa-2x text-warning opacity-50"></i>
            </div>
            <div class="fs-3 fw-bold text-dark mt-2 font-monospace">@Model.PendingOrders</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card p-3 shadow-sm h-100 border-start border-success border-4">
            <div class="d-flex justify-content-between align-items-center">
                <span class="text-secondary fw-semibold small text-uppercase">Completed Orders</span>
                <i class="fas fa-check-circle fa-2x text-success opacity-50"></i>
            </div>
            <div class="fs-3 fw-bold text-dark mt-2 font-monospace">@Model.CompletedOrders</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card p-3 shadow-sm h-100 border-start border-info border-4">
            <div class="d-flex justify-content-between align-items-center">
                <span class="text-secondary fw-semibold small text-uppercase">Active Stages</span>
                <i class="fas fa-tasks fa-2x text-info opacity-50"></i>
            </div>
            <div class="fs-3 fw-bold text-dark mt-2 font-monospace">
                @(Model.CuttingCount + Model.StitchingCount + Model.EmbroideryCount + Model.FinishingCount + Model.QCCount)
            </div>
        </div>
    </div>
</div>

<!-- Stage-wise Breakdown -->
<div class="row g-3 mb-4">
    <div class="col-12">
        <div class="card p-4 shadow-sm">
            <h6 class="fw-semibold text-dark mb-3 d-flex align-items-center gap-2">
                <i class="fas fa-chart-pie text-primary"></i> Stage-wise Production Status
            </h6>
            <div class="row g-3">
                <div class="col-6 col-md-2 text-center">
                    <div class="p-2 rounded-3" style="background: #e3f2fd;">
                        <span class="badge bg-info text-white rounded-pill px-2">Cutting</span>
                        <div class="fs-4 fw-bold text-dark mt-1">@Model.CuttingCount</div>
                    </div>
                </div>
                <div class="col-6 col-md-2 text-center">
                    <div class="p-2 rounded-3" style="background: #fff3e0;">
                        <span class="badge bg-warning text-dark rounded-pill px-2">Stitching</span>
                        <div class="fs-4 fw-bold text-dark mt-1">@Model.StitchingCount</div>
                    </div>
                </div>
                <div class="col-6 col-md-2 text-center">
                    <div class="p-2 rounded-3" style="background: #e8eaf6;">
                        <span class="badge bg-primary text-white rounded-pill px-2">Embroidery</span>
                        <div class="fs-4 fw-bold text-dark mt-1">@Model.EmbroideryCount</div>
                    </div>
                </div>
                <div class="col-6 col-md-2 text-center">
                    <div class="p-2 rounded-3" style="background: #f5f5f5;">
                        <span class="badge bg-secondary text-white rounded-pill px-2">Finishing</span>
                        <div class="fs-4 fw-bold text-dark mt-1">@Model.FinishingCount</div>
                    </div>
                </div>
                <div class="col-6 col-md-2 text-center">
                    <div class="p-2 rounded-3" style="background: #fce4ec;">
                        <span class="badge bg-danger text-white rounded-pill px-2">Quality Control</span>
                        <div class="fs-4 fw-bold text-dark mt-1">@Model.QCCount</div>
                    </div>
                </div>
                <div class="col-6 col-md-2 text-center">
                    <div class="p-2 rounded-3" style="background: #e8f5e9;">
                        <span class="badge bg-success text-white rounded-pill px-2">Completed</span>
                        <div class="fs-4 fw-bold text-dark mt-1">@Model.CompletedOrders</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Production Activities -->
<div class="row g-3">
    <div class="col-12">
        <div class="card p-4 shadow-sm">
            <h6 class="fw-semibold text-dark mb-3 d-flex align-items-center gap-2">
                <i class="fas fa-list text-primary"></i> Recent Production Activities
            </h6>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-secondary text-uppercase fs-7">
                        <tr>
                            <th>Order #</th>
                            <th>Stage</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentActivities != null && Model.RecentActivities.Any())
                        {
                            foreach (var item in Model.RecentActivities)
                            {
                                var stageColors = new Dictionary<string, string>
                                {
                                    { "Cutting", "bg-info" },
                                    { "Stitching", "bg-warning text-dark" },
                                    { "Embroidery", "bg-primary" },
                                    { "Finishing", "bg-secondary" },
                                    { "QC", "bg-danger" }
                                };
                                var stageColor = stageColors.ContainsKey(item.Stage) ? stageColors[item.Stage] : "bg-secondary";

                                var statusColor = item.Status == "Completed" ? "bg-success" : item.Status == "InProgress" ? "bg-info" : "bg-warning text-dark";

                                <tr>
                                    <td class="fw-semibold">@item.OrderNumber</td>
                                    <td><span class="badge @stageColor rounded-pill px-2">@item.Stage</span></td>
                                    <td><span class="badge @statusColor rounded-pill px-2">@item.Status</span></td>
                                    <td>@item.Date.ToString("dd MMM yyyy HH:mm")</td>
                                    <td>@item.Notes</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">
                                    <i class="fas fa-inbox fa-2x d-block mb-2 opacity-25"></i>
                                    No recent activities found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>