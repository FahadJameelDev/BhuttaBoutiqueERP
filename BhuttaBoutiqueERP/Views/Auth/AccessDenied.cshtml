@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Access Denied - Bhutta Boutique ERP</title>

    <!-- Bootstrap 5 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- FontAwesome 6 CDN -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet" />

    <style>
        /* ── Gradient Background (Same as Login) ── */
        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 40%, #0ea5e9 100%);
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            padding: 1rem;
        }

        /* ── Glassmorphism Card ── */
        .access-card {
            background: rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 32px;
            box-shadow: 0 25px 80px rgba(0, 0, 0, 0.6);
            padding: 2.5rem 2rem;
            width: 100%;
            max-width: 440px;
            animation: fadeUp 0.8s ease forwards;
            opacity: 0;
            transform: translateY(30px);
        }

        /* ── Inner Card ── */
        .access-card-inner {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            padding: 2.5rem 2rem;
            box-shadow: inset 0 1px 0 rgba(255,255,255,0.6);
            text-align: center;
        }

        /* ── Icon ── */
        .lock-icon {
            font-size: 4rem;
            color: #dc2626;
            background: rgba(220, 38, 38, 0.1);
            width: 100px;
            height: 100px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            margin: 0 auto 1.2rem auto;
            border: 2px solid rgba(220, 38, 38, 0.2);
        }

        /* ── Title ── */
        .access-title {
            font-size: 1.8rem;
            font-weight: 700;
            color: #0f172a;
            letter-spacing: -0.5px;
        }
        .access-sub {
            font-size: 0.95rem;
            color: #64748b;
            margin-top: 0.3rem;
        }

        /* ── Button ── */
        .btn-back {
            background: linear-gradient(135deg, #1e3a8a 0%, #1a56db 100%);
            border: none;
            border-radius: 14px;
            padding: 0.7rem 2rem;
            font-weight: 600;
            color: white;
            transition: all 0.3s ease;
            box-shadow: 0 6px 20px rgba(26, 86, 219, 0.35);
            text-decoration: none;
            display: inline-block;
        }
        .btn-back:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 30px rgba(26, 86, 219, 0.45);
            background: linear-gradient(135deg, #1a56db 0%, #1e3a8a 100%);
            color: white;
        }

        /* ── Animation ── */
        @@keyframes fadeUp {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* ── Responsive ── */
        @@media (max-width: 480px) {
            .access-card {
                padding: 1.2rem 1rem;
            }
            .access-card-inner {
                padding: 1.8rem 1.2rem;
            }
            .lock-icon {
                width: 75px;
                height: 75px;
                font-size: 2.8rem;
            }
            .access-title {
                font-size: 1.4rem;
            }
        }
    </style>
</head>
<body>

    <div class="access-card">
        <div class="access-card-inner">

            <!-- Icon -->
            <div class="lock-icon">
                <i class="fas fa-lock"></i>
            </div>

            <!-- Title -->
            <h3 class="access-title">Access Denied</h3>
            <p class="access-sub">You do not have permission to access this page.</p>

            <!-- Button -->
            <a asp-action="Login" class="btn-back mt-3">
                <i class="fas fa-arrow-left me-2"></i>Back to Login
            </a>

        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js">
    </script>

</body>
</html>