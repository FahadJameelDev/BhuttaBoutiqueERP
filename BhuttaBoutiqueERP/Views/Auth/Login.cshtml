@model BhuttaBoutiqueERP.Models.Auth.ViewModels.LoginViewModel

@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Bhutta Boutique ERP</title>

    <!-- Bootstrap 5 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- FontAwesome 6 CDN (Updated to fa-solid standard) -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <style>
        /* ── Enterprise Gradient Background ── */
        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #14532d 0%, #166534 50%, #0f172a 100%);
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            padding: 1rem;
        }

        /* ── Glassmorphism Card ── */
        .login-card {
            background: rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 24px;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.3);
            padding: 2rem 1.8rem;
            width: 100%;
            max-width: 420px;
            animation: fadeUp 0.6s ease forwards;
            opacity: 0;
            transform: translateY(20px);
        }

        /* ── Inner Card (Content) ── */
        .login-card-inner {
            background: #ffffff;
            border-radius: 16px;
            padding: 2rem 1.5rem;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        }

        /* ── Brand Styling ── */
        .brand-icon-box {
            width: 56px;
            height: 56px;
            background: #14532d;
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 16px;
            margin: 0 auto 12px auto;
            font-size: 1.5rem;
            box-shadow: 0 8px 16px rgba(20, 83, 45, 0.25);
        }
        .brand-title {
            font-size: 1.4rem;
            font-weight: 700;
            color: #0f172a;
            letter-spacing: -0.02em;
        }
        .brand-sub {
            font-size: 0.8rem;
            color: #64748b;
            font-weight: 500;
            margin-top: 2px;
        }

        /* ── Form Controls & Input Groups ── */
        .form-control {
            border-radius: 0 10px 10px 0;
            padding: 0.65rem 0.9rem;
            border: 1px solid #CBD5E1;
            background: #FFFFFF;
            font-size: 13px;
            color: #0F172A;
        }
        .form-control:focus {
            border-color: #15803d;
            box-shadow: 0 0 0 3px rgba(21, 128, 61, 0.12);
            background: #ffffff;
        }
        .input-group-text {
            background: #F8FAFC;
            border: 1px solid #CBD5E1;
            border-right: none;
            border-radius: 10px 0 0 10px;
            color: #64748b;
            font-size: 13px;
            padding: 0 0.9rem;
        }

        /* ── Password Toggle Button Fix ── */
        .toggle-pwd {
            border: 1px solid #CBD5E1;
            border-left: none;
            border-radius: 0 10px 10px 0;
            background: #F8FAFC;
            color: #64748b;
            padding: 0 0.9rem;
            transition: 0.2s;
        }
        .toggle-pwd:hover {
            background: #E2E8F0;
            color: #14532d;
        }
        /* Adjust input border radius when toggle button is present */
        .password-group .form-control {
            border-radius: 0;
            border-right: none;
        }

        /* ── Login Button ── */
        .btn-login {
            background: linear-gradient(135deg, #14532d 0%, #166534 100%);
            border: none;
            border-radius: 10px;
            padding: 0.7rem;
            font-weight: 600;
            font-size: 13.5px;
            color: white;
            width: 100%;
            transition: all 0.2s ease;
            box-shadow: 0 4px 12px rgba(20, 83, 45, 0.25);
        }
        .btn-login:hover {
            background: linear-gradient(135deg, #166534 0%, #14532d 100%);
            box-shadow: 0 6px 16px rgba(20, 83, 45, 0.35);
        }

        /* ── Validation ── */
        .validation-summary-errors {
            background: #FEF2F2;
            border-radius: 8px;
            padding: 0.5rem 0.8rem;
            color: #991B1B;
            font-size: 12px;
            margin-bottom: 1rem;
            border-left: 3px solid #EF4444;
        }
        .field-validation-error {
            font-size: 11.5px;
            color: #EF4444;
            margin-top: 3px;
            display: block;
            font-weight: 500;
        }

        /* ── Animation ── */
        @@keyframes fadeUp {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>
<body>

    <div class="login-card">
        <div class="login-card-inner">

            <!-- Brand Header -->
            <div class="text-center mb-4">
                <div class="brand-icon-box">
                    <i class="fa-solid fa-shirt"></i>
                </div>
                <div class="brand-title">Bhutta Boutique ERP</div>
                <div class="brand-sub">Secure Enterprise Management Portal</div>
            </div>

            <!-- Validation Summary -->
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <!-- Login Form -->
            <form asp-action="Login" method="post" novalidate>

                <!-- Email Field -->
                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold text-secondary" style="font-size: 12px;">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="fa-solid fa-envelope"></i>
                        </span>
                        <input asp-for="Email" class="form-control" placeholder="admin@bhuttaboutique.com" autofocus />
                    </div>
                    <span asp-validation-for="Email" class="field-validation-error"></span>
                </div>

                <!-- Password Field -->
                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-semibold text-secondary" style="font-size: 12px;">Password</label>
                    <div class="input-group password-group">
                        <span class="input-group-text">
                            <i class="fa-solid fa-lock"></i>
                        </span>
                        <input asp-for="Password" class="form-control" placeholder="••••••••" id="Password" />
                        <button class="toggle-pwd" type="button" id="togglePassword" title="Show/Hide Password">
                            <i class="fa-solid fa-eye" id="pwdIcon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="field-validation-error"></span>
                </div>

               

                <!-- Login Button -->
                <button type="submit" class="btn-login">
                    <i class="fa-solid fa-right-to-bracket me-2"></i>Sign In to Dashboard
                </button>

            </form>

            <!-- Footer -->
            <div class="text-center mt-4 pt-2 border-top border-light">
                <p class="text-muted mb-0" style="font-size: 11.5px;">
                    &copy; @DateTime.Now.Year Bhutta Boutique ERP &bull; All Rights Reserved
                </p>
            </div>

        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Toggle Password Visibility Script
        document.getElementById('togglePassword')?.addEventListener('click', function() {
            const pwd = document.getElementById('Password');
            const icon = document.getElementById('pwdIcon');
            if (pwd.type === 'password') {
                pwd.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                pwd.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        });
    </script>
</body>
</html>