@model IEnumerable<BhuttaBoutiqueERP.Models.Services.Entities.DesignLibrary>

@{
    ViewData["Title"] = "Design Library";
}

<!-- Sticky Header Strip -->
<div class="sticky-header-strip">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h3 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                <i class="fas fa-palette text-primary"></i> Design Library
            </h3>
            <p class="text-secondary small mb-0">Manage embroidery designs, patterns, and creative assets.</p>
        </div>
        <button type="button" class="btn btn-primary px-4 rounded-pill shadow-sm open-modal-btn" data-url="@Url.Action("Create")">
            <i class="fas fa-plus me-1"></i> Add Design
        </button>
    </div>
</div>

<!-- Main Content Card -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive sticky-table-wrap">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary text-uppercase fs-7">
                    <tr>
                        <th class="ps-4">Name</th>
                        <th>Category</th>
                        <th>Type</th>
                        <th>Price</th>
                        <th>Complexity</th>
                        <th>Image</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4"><span class="fw-semibold text-dark">@item.Name</span></td>
                                <td><span class="badge bg-light text-dark border">@item.Category</span></td>
                                <td><span class="badge bg-info text-dark">@item.Type</span></td>
                                <td class="fw-semibold">
                                    @* ✅ Null safe price formatting *@
                                    @(item.Price.ToString("N0")) PKR
                                </td>
                                <td>
                                    <span class="badge @(item.Complexity == "Hard" ? "bg-danger" : item.Complexity == "Medium" ? "bg-warning text-dark" : "bg-success") rounded-pill px-2">
                                        @item.Complexity
                                    </span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.Image))
                                    {
                                        <img src="@item.Image" alt="@item.Name" style="width: 40px; height: 40px; object-fit: cover; border-radius: 4px;" />
                                    }
                                    else
                                    {
                                        <span class="text-muted">No image</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @(item.Status == "Active" ? "bg-success-subtle text-success border border-success-subtle" : "bg-secondary-subtle text-secondary") rounded-pill px-2">
                                        @item.Status
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <button type="button" class="btn btn-sm btn-light text-primary border me-1 open-modal-btn" data-url="@Url.Action("Edit", new { id = item.Id })" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-light text-danger border open-modal-btn" data-url="@Url.Action("Delete", new { id = item.Id })" title="Delete">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-5">
                                <i class="fas fa-inbox fa-3x d-block mb-2 opacity-25"></i>
                                <p class="mb-0 fw-medium">No designs found in the library.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>