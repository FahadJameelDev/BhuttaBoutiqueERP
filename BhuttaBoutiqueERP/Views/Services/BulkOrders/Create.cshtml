@model BhuttaBoutiqueERP.Models.Services.ViewModels.BulkOrderViewModel

<div class="modal-dialog modal-lg">
    <div class="modal-content">
        <div class="modal-header bg-light">
            <h5 class="modal-title text-dark fw-bold" style="font-size: 16px;">
                <i class="fas fa-plus-circle me-2 text-primary"></i>New Bulk Order
            </h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <form asp-action="Create" method="post" class="ajax-form">
            <div class="modal-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="CustomerId" class="form-label"></label>
                        <select asp-for="CustomerId" class="form-select" asp-items="@(new SelectList(ViewBag.Customers, "Id", "Name"))">
                            <option value="">-- Select Customer --</option>
                        </select>
                        <span asp-validation-for="CustomerId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="TotalItems" class="form-label"></label>
                        <input asp-for="TotalItems" class="form-control" type="number" />
                        <span asp-validation-for="TotalItems" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="TotalPrice" class="form-label"></label>
                        <input asp-for="TotalPrice" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="TotalPrice" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Discount" class="form-label"></label>
                        <input asp-for="Discount" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="Discount" class="text-danger"></span>
                        <small class="text-muted">Optional discount amount</small>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="OrderDate" class="form-label"></label>
                        <input asp-for="OrderDate" class="form-control" type="date" />
                        <span asp-validation-for="OrderDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DeliveryDate" class="form-label"></label>
                        <input asp-for="DeliveryDate" class="form-control" type="date" />
                        <span asp-validation-for="DeliveryDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label"></label>
                        <select asp-for="Status" class="form-select">
                            <option value="Pending">Pending</option>
                            <option value="Processing">Processing</option>
                            <option value="Completed">Completed</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary px-4" style="font-weight: 600;">
                    <i class="fas fa-save me-1"></i> Save Bulk Order
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}