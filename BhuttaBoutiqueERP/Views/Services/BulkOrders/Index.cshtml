@model IEnumerable<BhuttaBoutiqueERP.Models.Services.Entities.BulkOrder>

@{
    ViewData["Title"] = "Bulk Orders";
}

<!-- Sticky Header Strip -->
<div class="sticky-header-strip">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h3 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                <i class="fas fa-people-group text-primary"></i> Bulk Orders
            </h3>
            <p class="text-secondary small mb-0">Manage wedding, party, and bulk customer orders efficiently.</p>
        </div>
        <button type="button" class="btn btn-primary px-4 rounded-pill shadow-sm open-modal-btn" data-url="@Url.Action("Create")">
            <i class="fas fa-plus me-1"></i> New Bulk Order
        </button>
    </div>
</div>

<!-- Main Content Card -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive sticky-table-wrap">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary text-uppercase fs-7">
                    <tr>
                        <th class="ps-4">Customer</th>
                        <th>Total Items</th>
                        <th>Total Price</th>
                        <th>Discount</th>
                        <th>Net Total</th>
                        <th>Order Date</th>
                        <th>Delivery Date</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            var netTotal = item.TotalPrice - (item.Discount ?? 0);
                            <tr>
                                <td class="ps-4"><span class="fw-semibold text-dark">@item.Customer?.Name</span></td>
                                <td>@item.TotalItems</td>
                                <td class="fw-semibold">@item.TotalPrice.ToString("N0") PKR</td>
                                <td>
                                    @if (item.Discount.HasValue && item.Discount.Value > 0)
                                    {
                                        <span class="badge bg-success text-white">@item.Discount.Value.ToString("N0") PKR</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">N/A</span>
                                    }
                                </td>
                                <td class="fw-bold text-primary">@netTotal.ToString("N0") PKR</td>
                                <td>@item.OrderDate.ToString("dd MMM yyyy")</td>
                                <td>@item.DeliveryDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    <span class="badge @(item.Status == "Completed" ? "bg-success" : item.Status == "Pending" ? "bg-warning text-dark" : "bg-info") rounded-pill px-2">
                                        @item.Status
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <button type="button" class="btn btn-sm btn-light text-danger border open-modal-btn" data-url="@Url.Action("Delete", new { id = item.Id })" title="Delete">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-5">
                                <i class="fas fa-inbox fa-3x d-block mb-2 opacity-25"></i>
                                <p class="mb-0 fw-medium">No bulk orders found.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>