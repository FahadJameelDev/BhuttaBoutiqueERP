@model BhuttaBoutiqueERP.Models.Services.Entities.BulkOrder

<div class="modal-dialog">
    <div class="modal-content">
        <div class="modal-header bg-danger text-white">
            <h5 class="modal-title fw-bold" style="font-size: 16px;">
                <i class="fas fa-trash-alt me-2"></i>Delete Bulk Order
            </h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <form asp-action="Delete" method="post" class="ajax-form">
            <input type="hidden" asp-for="Id" />

            <div class="modal-body">
                <div class="alert alert-warning mb-3" role="alert">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    Are you sure you want to delete this bulk order? This action cannot be undone.
                </div>

                <div class="p-3 bg-light rounded border">
                    <p class="mb-1"><strong>Customer:</strong> @Model.Customer?.Name</p>
                    <p class="mb-1"><strong>Total Items:</strong> @Model.TotalItems</p>
                    <p class="mb-1"><strong>Total Price:</strong> @Model.TotalPrice.ToString("N0") PKR</p>
                    <p class="mb-1"><strong>Discount:</strong> @(Model.Discount?.ToString("N0") ?? "N/A") PKR</p>
                    <p class="mb-1"><strong>Order Date:</strong> @Model.OrderDate.ToString("dd MMM yyyy")</p>
                    <p class="mb-0"><strong>Status:</strong> @Model.Status</p>
                </div>
            </div>

            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-danger px-4" style="font-weight: 600;">
                    <i class="fas fa-trash me-1"></i> Confirm Delete
                </button>
            </div>
        </form>
    </div>
</div>