@model IEnumerable<BhuttaBoutiqueERP.Models.Services.Entities.Order>

@{
    ViewData["Title"] = "Orders";
}

<!-- Sticky Header Strip -->
<div class="sticky-header-strip">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h3 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                <i class="fas fa-cart-shopping text-primary"></i> Orders
            </h3>
            <p class="text-secondary small mb-0">Manage customer orders, bookings, and delivery schedules.</p>
        </div>
        <button type="button" class="btn btn-primary px-4 rounded-pill shadow-sm open-modal-btn" data-url="@Url.Action("Create")">
            <i class="fas fa-plus me-1"></i> New Order
        </button>
    </div>
</div>

<!-- Main Content Card -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive sticky-table-wrap">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary text-uppercase fs-7">
                    <tr>
                        <th class="ps-4">Order #</th>
                        <th>Customer</th>
                        <th>Service</th>
                        <th>Total</th>
                        <th>Advance</th>
                        <th>Remaining</th>
                        <th>Status</th>
                        <th>Delivery</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4"><span class="fw-semibold text-dark">@item.OrderNumber</span></td>
                                <td>@item.Customer?.Name</td>
                                <td>@item.Service?.Name</td>
                                <td class="fw-semibold">@item.Total.ToString("N0") PKR</td>
                                <td>@item.Advance.ToString("N0") PKR</td>
                                <td>@item.Remaining.ToString("N0") PKR</td>
                                <td>
                                    <span class="badge @(item.Status == "Completed" ? "bg-success" : item.Status == "Pending" ? "bg-warning text-dark" : "bg-info") rounded-pill px-2">
                                        @item.Status
                                    </span>
                                </td>
                                <td>@item.DeliveryDate.ToString("dd MMM yyyy")</td>
                                <td class="text-end pe-4">
                                    <button type="button" class="btn btn-sm btn-light text-primary border me-1 open-modal-btn" data-url="@Url.Action("Edit", new { id = item.Id })" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-light text-danger border open-modal-btn" data-url="@Url.Action("Delete", new { id = item.Id })" title="Delete">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-5">
                                <i class="fas fa-inbox fa-3x d-block mb-2 opacity-25"></i>
                                <p class="mb-0 fw-medium">No orders found.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>