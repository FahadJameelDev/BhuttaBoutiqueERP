@model BhuttaBoutiqueERP.ViewModels.Reports.HRReportVM

@{
    ViewData["Title"] = "HR & Payroll Summary Report";
}

<div class="container-fluid px-4">
    <!-- 1️⃣ HEADER STRIP -->
    <div class="sticky-header-strip d-flex justify-content-between align-items-center py-3 mb-4 border-bottom bg-white">
        <div>
            <h1 class="h3 mb-0 text-gray-800">HR & Payroll Reports</h1>
            <p class="text-muted small mb-0">Monitor staff presence, designations, and payroll summaries.</p>
        </div>
        <div>
            <button class="btn btn-primary" onclick="window.print();">
                <i class="fas fa-print me-1"></i> Print / Export
            </button>
        </div>
    </div>

    <!-- Metrics Cards Row -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 p-3 bg-light">
                <h6 class="text-muted">Total Employees</h6>
                <h3 class="fw-bold">@Model.TotalEmployees</h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 p-3 bg-light">
                <h6 class="text-muted">Present Today</h6>
                <h3 class="fw-bold text-success">@Model.PresentTodayCount</h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 p-3 bg-light">
                <h6 class="text-muted">Total Monthly Payroll</h6>
                <h3 class="fw-bold text-primary">PKR @Model.TotalMonthlyPayroll.ToString("N0")</h3>
            </div>
        </div>
    </div>

    <!-- 2️⃣ TABLE WRAPPER -->
    <div class="card shadow-sm border-0">
        <div class="table-responsive sticky-table-wrap" style="max-height: 600px; overflow-y: auto;">
            <table class="table table-hover align-middle mb-0">
                <!-- 3️⃣ THEAD -->
                <thead class="bg-light text-secondary text-uppercase fs-7 sticky-top" style="z-index: 1;">
                    <tr>
                        <th class="ps-4">#</th>
                        <th>Employee Name</th>
                        <th>Designation</th>
                        <th>Phone</th>
                        <th class="pe-4">Attendance Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        int index = 1;
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="ps-4">@(index++)</td>
                                <td><span class="fw-bold">@item.EmployeeName</span></td>
                                <td>@item.Designation</td>
                                <td>@item.Phone</td>
                                <td class="pe-4">
                                    <span class="badge bg-success">
                                        @item.AttendanceStatus
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <!-- 5️⃣ EMPTY STATE -->
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <div class="text-muted">
                                    <i class="fas fa-inbox fa-3x mb-3"></i>
                                    <p class="mb-0">No employee records found.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>