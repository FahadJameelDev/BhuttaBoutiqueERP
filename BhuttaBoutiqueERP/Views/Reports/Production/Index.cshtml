@model BhuttaBoutiqueERP.ViewModels.Reports.ProductionReportVM

@{
    ViewData["Title"] = "Production Summary Report";
}

<div class="container-fluid px-4">
    <!-- Header Strip -->
    <div class="sticky-header-strip d-flex justify-content-between align-items-center py-3 mb-4 border-bottom bg-white">
        <div>
            <h1 class="h3 mb-0 text-gray-800">Production Reports</h1>
            <p class="text-muted small mb-0">Track manufacturing pipelines, tailor assignments, and workflow stages.</p>
        </div>
        <div>
            <button class="btn btn-primary" onclick="printSelectedRows()">
                <i class="fas fa-print me-1"></i> Print Selected
            </button>
        </div>
    </div>

    <!-- Metrics Cards Row -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 p-3 bg-light">
                <h6 class="text-muted">Total In Production</h6>
                <h3 class="fw-bold">@Model.TotalOrdersInProduction</h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 p-3 bg-light">
                <h6 class="text-muted">Completed Orders</h6>
                <h3 class="fw-bold text-success">@Model.CompletedOrdersCount</h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 p-3 bg-light">
                <h6 class="text-muted">Fabric Issued (Meters)</h6>
                <h3 class="fw-bold text-primary">@Model.TotalFabricIssuedMeters</h3>
            </div>
        </div>
    </div>

    <!-- Table Wrapper -->
    <div class="card shadow-sm border-0">
        <div class="table-responsive sticky-table-wrap" style="max-height: 600px; overflow-y: auto;">
            <table class="table table-hover align-middle mb-0" id="reportTable">
                <thead class="bg-light text-secondary text-uppercase fs-7 sticky-top" style="z-index: 1;">
                    <tr>
                        <th class="ps-4" style="width: 40px;">
                            <input type="checkbox" id="selectAll" />
                        </th>
                        <th>#</th>
                        <th>Order Number</th>
                        <th>Design Name</th>
                        <th>Assigned Tailor</th>
                        <th>Current Stage</th>
                        <th class="pe-4">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        int index = 1;
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="ps-4">
                                    <input type="checkbox" class="row-checkbox" />
                                </td>
                                <td>@(index++)</td>
                                <td><span class="fw-bold">@item.OrderNumber</span></td>
                                <td>@item.DesignName</td>
                                <td>@item.AssignedTailor</td>
                                <td>@item.CurrentStage</td>
                                <td class="pe-4">
                                    <span class="badge @(item.Status.Contains("Finished") ? "bg-success" : "bg-warning text-dark")">
                                        @item.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <!-- Empty State -->
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <div class="text-muted">
                                    <i class="fas fa-inbox fa-3x mb-3"></i>
                                    <p class="mb-0">No production logs found.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    // Select All Checkbox Toggle
    document.getElementById('selectAll').addEventListener('change', function () {
        var checkboxes = document.querySelectorAll('.row-checkbox');
        checkboxes.forEach(cb => cb.checked = this.checked);
    });

    // Print Only Selected Rows Function
    function printSelectedRows() {
        var selectedCheckboxes = document.querySelectorAll('.row-checkbox:checked');
        if (selectedCheckboxes.length === 0) {
            alert('Please select at least one row to print.');
            return;
        }

        var allRows = document.querySelectorAll('#reportTable tbody tr');
        
        // Hide unselected rows temporarily
        allRows.forEach(row => {
            var cb = row.querySelector('.row-checkbox');
            if (cb && !cb.checked) {
                row.style.display = 'none';
            }
        });

        // Trigger Browser Print Dialog
        window.print();

        // Restore hidden rows back after printing
        allRows.forEach(row => {
            row.style.display = '';
        });
    }
</script>