@model BhuttaBoutiqueERP.Models.Reports.SalesReportViewModel

@{
    ViewData["Title"] = "Sales Report";
}

<div class="container-fluid px-4 py-3">
    <!-- 1️⃣ Sticky Header Strip Pattern -->
    <div class="sticky-header-strip d-flex justify-content-between align-items-center mb-4 p-3 bg-white shadow-sm rounded">
        <div>
            <h2 class="fw-bold text-dark mb-1">📊 Sales Report</h2>
            <p class="text-muted mb-0">Track revenue, order volumes, and customer payment statuses.</p>
        </div>
        <div>
            <button class="btn btn-primary shadow-sm" onclick="printSelectedRows()">
                <i class="fas fa-print me-1"></i> Print Selected
            </button>
        </div>
    </div>

    <!-- Filter Form Card -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body bg-light rounded">
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-secondary small">Start Date</label>
                    <input type="date" name="startDate" value="@Model.StartDate?.ToString("yyyy-MM-dd")" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-secondary small">End Date</label>
                    <input type="date" name="endDate" value="@Model.EndDate?.ToString("yyyy-MM-dd")" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-secondary small">Payment Status</label>
                    <select name="paymentStatus" class="form-select">
                        <option value="">All Statuses</option>
                        <option value="Paid" selected="@(Model.PaymentStatus == "Paid")">Paid</option>
                        <option value="Partial" selected="@(Model.PaymentStatus == "Partial")">Partial</option>
                        <option value="Unpaid" selected="@(Model.PaymentStatus == "Unpaid")">Unpaid</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100 shadow-sm">
                        <i class="fas fa-filter me-1"></i> Filter
                    </button>
                    <a asp-action="Index" class="btn btn-outline-dark w-100">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Summary KPI Cards Row -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm border-start border-primary border-4 py-2">
                <div class="card-body">
                    <div class="text-xs fw-bold text-primary text-uppercase mb-1">Total Revenue</div>
                    <div class="h5 mb-0 fw-bold text-dark">Rs. @Model.TotalSalesRevenue.ToString("N2")</div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm border-start border-success border-4 py-2">
                <div class="card-body">
                    <div class="text-xs fw-bold text-success text-uppercase mb-1">Total Payments Received</div>
                    <div class="h5 mb-0 fw-bold text-dark">Rs. @Model.TotalPaymentsReceived.ToString("N2")</div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm border-start border-danger border-4 py-2">
                <div class="card-body">
                    <div class="text-xs fw-bold text-danger text-uppercase mb-1">Pending Dues</div>
                    <div class="h5 mb-0 fw-bold text-dark">Rs. @Model.TotalPendingDues.ToString("N2")</div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm border-start border-info border-4 py-2">
                <div class="card-body">
                    <div class="text-xs fw-bold text-info text-uppercase mb-1">Total Orders</div>
                    <div class="h5 mb-0 fw-bold text-dark">@Model.TotalOrdersCount</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Detailed Records Table Card with Sticky Table Wrap Pattern -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-bold text-dark"><i class="fas fa-list me-2 text-primary"></i>Sales Transaction Details</h5>
        </div>
        <div class="card-body p-0">
            <!-- 2️⃣ Table Wrapper Pattern with Scroll & Sticky Header -->
            <div class="table-responsive sticky-table-wrap" style="max-height: 600px; overflow-y: auto;">
                <table class="table table-hover align-middle mb-0" id="reportTable">
                    <!-- 3️⃣ Thead Pattern -->
                    <thead class="bg-light text-secondary text-uppercase fs-7 sticky-top" style="z-index: 1;">
                        <tr>
                            <th class="ps-4" style="width: 40px;">
                                <input type="checkbox" id="selectAll" />
                            </th>
                            <th>Order #</th>
                            <th>Customer</th>
                            <th>Date</th>
                            <th>Total (Rs.)</th>
                            <th>Paid (Rs.)</th>
                            <th>Remaining</th>
                            <th>Order Status</th>
                            <th class="pe-4">Payment</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.SalesRecords != null && Model.SalesRecords.Any())
                        {
                            foreach (var item in Model.SalesRecords)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <input type="checkbox" class="row-checkbox" />
                                    </td>
                                    <td class="fw-bold text-primary">@item.OrderNumber</td>
                                    <td>
                                        <div class="fw-semibold text-dark">@item.CustomerName</div>
                                        <small class="text-muted">@item.CustomerPhone</small>
                                    </td>
                                    <td>@item.OrderDate.ToString("dd MMM yyyy")</td>
                                    <td class="fw-semibold">@item.TotalAmount.ToString("N2")</td>
                                    <td class="text-success">@item.PaidAmount.ToString("N2")</td>
                                    <td class="text-danger fw-semibold">@item.RemainingAmount.ToString("N2")</td>
                                    <td>
                                        <span class="badge bg-secondary">@item.OrderStatus</span>
                                    </td>
                                    <td class="pe-4">
                                        @if (item.PaymentStatus == "Paid")
                                        {
                                            <span class="badge bg-success">Paid</span>
                                        }
                                        else if (item.PaymentStatus == "Partial")
                                        {
                                            <span class="badge bg-warning text-dark">Partial</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Unpaid</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <!-- 5️⃣ Empty State Pattern -->
                            <tr>
                                <td colspan="9" class="text-center py-5 text-muted">
                                    <i class="fas fa-inbox fa-3x mb-3 text-secondary opacity-50 d-block"></i>
                                    <span class="fw-semibold">No sales records found for the selected criteria.</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    // Select All Checkbox Toggle
    document.getElementById('selectAll').addEventListener('change', function () {
        var checkboxes = document.querySelectorAll('.row-checkbox');
        checkboxes.forEach(cb => cb.checked = this.checked);
    });

    // Print Only Selected Rows Function
    function printSelectedRows() {
        var selectedCheckboxes = document.querySelectorAll('.row-checkbox:checked');
        if (selectedCheckboxes.length === 0) {
            alert('Please select at least one row to print.');
            return;
        }

        var allRows = document.querySelectorAll('#reportTable tbody tr');
        
        // Hide unselected rows temporarily
        allRows.forEach(row => {
            var cb = row.querySelector('.row-checkbox');
            if (cb && !cb.checked) {
                row.style.display = 'none';
            }
        });

        // Trigger Browser Print Dialog
        window.print();

        // Restore hidden rows back after printing
        allRows.forEach(row => {
            row.style.display = '';
        });
    }
</script>