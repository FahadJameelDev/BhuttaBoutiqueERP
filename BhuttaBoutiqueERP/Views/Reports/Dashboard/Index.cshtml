@model BhuttaBoutiqueERP.Models.Reports.ViewModels.DashboardOverviewViewModel

@{
    ViewData["Title"] = "Reports Dashboard";
}

<!-- 1️⃣ HEADER STRIP -->
<div class="sticky-header-strip d-flex justify-content-between align-items-center py-3 mb-4 bg-white border-bottom shadow-sm px-4 rounded">
    <div>
        <h1 class="h3 text-success fw-bold mb-0">
            <i class="fas fa-chart-line me-2"></i> Reports Dashboard
        </h1>
        <p class="text-muted small mb-0">Comprehensive overview and real-time analytics across all modules.</p>
    </div>
    <div>
        <button type="button" class="btn btn-success px-4 rounded-pill shadow-sm" onclick="location.reload();">
            <i class="fas fa-sync-alt me-1"></i> Refresh Metrics
        </button>
    </div>
</div>

<!-- 4 Top Metric Cards (Directly Embedded - No Partial View Needed) -->
<div class="row g-4 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm border-start border-success border-4 h-100 py-2">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-xs fw-bold text-success text-uppercase mb-1">Total Revenue</div>
                    <div class="h5 mb-0 fw-bold text-dark">@Model.TotalRevenue.ToString("N0") PKR</div>
                </div>
                <i class="fas fa-wallet fa-2x text-success"></i>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm border-start border-primary border-4 h-100 py-2">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-xs fw-bold text-primary text-uppercase mb-1">Total Orders</div>
                    <div class="h5 mb-0 fw-bold text-dark">@Model.TotalOrders</div>
                </div>
                <i class="fas fa-shopping-cart fa-2x text-primary"></i>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm border-start border-warning border-4 h-100 py-2">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-xs fw-bold text-warning text-uppercase mb-1">Pending Orders</div>
                    <div class="h5 mb-0 fw-bold text-dark">@Model.PendingOrders</div>
                </div>
                <i class="fas fa-clock fa-2x text-warning"></i>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm border-start border-danger border-4 h-100 py-2">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-xs fw-bold text-danger text-uppercase mb-1">Low Stock Items</div>
                    <div class="h5 mb-0 fw-bold text-dark">@Model.LowStockItemsCount</div>
                </div>
                <i class="fas fa-exclamation-triangle fa-2x text-danger"></i>
            </div>
        </div>
    </div>
</div>

<!-- Lower Rich Content Section with Golden Rule Tables -->
<div class="row g-4 mb-4">
    <!-- Workforce Table -->
    <div class="col-xl-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3">
                <h6 class="fw-bold mb-0 text-dark"><i class="fas fa-users-cog me-2 text-primary"></i> HR & Workforce Snapshot</h6>
            </div>
            <div class="card-body p-0">
                <!-- 2️⃣ TABLE WRAPPER -->
                <div class="table-responsive sticky-table-wrap">
                    <table class="table table-hover align-middle mb-0">
                        <!-- 3️⃣ THEAD -->
                        <thead class="bg-light text-secondary text-uppercase fs-7">
                            <tr>
                                <th class="ps-4">Metric</th>
                                <th class="text-end pe-4">Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="ps-4 fw-semibold text-secondary">Active Employees</td>
                                <td class="text-end pe-4 fw-bold text-dark">@Model.ActiveEmployees</td>
                            </tr>
                            <tr>
                                <td class="ps-4 fw-semibold text-secondary">Present Today</td>
                                <td class="text-end pe-4">
                                    <span class="badge bg-success bg-opacity-10 text-success px-2 py-1">@Model.PresentEmployeesToday Present</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- System Alerts Summary Box -->
    <div class="col-xl-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3">
                <h6 class="fw-bold mb-0 text-dark"><i class="fas fa-exclamation-triangle me-2 text-danger"></i> System Alerts Summary</h6>
            </div>
            <div class="card-body d-flex flex-column justify-content-center p-4">
                <div class="d-flex justify-content-between align-items-center p-3 mb-3 bg-light rounded-3">
                    <span class="fw-semibold text-secondary">Low Stock Items Requiring Attention</span>
                    <span class="badge bg-danger fs-6 px-3 py-2">@Model.LowStockItemsCount Items</span>
                </div>
                <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded-3">
                    <span class="fw-semibold text-secondary">Pending Orders in Queue</span>
                    <span class="badge bg-warning text-dark fs-6 px-3 py-2">@Model.PendingOrders Orders</span>
                </div>
            </div>
        </div>
    </div>
</div>