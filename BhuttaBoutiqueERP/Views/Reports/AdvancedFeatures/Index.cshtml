@model IEnumerable<BhuttaBoutiqueERP.ViewModels.Reports.ActivityLogVM>

@{
    ViewData["Title"] = "Advanced Features - Tools & Logs";
}

<div class="container-fluid px-4">
    <!-- 1️⃣ HEADER STRIP -->
    <div class="sticky-header-strip d-flex justify-content-between align-items-center py-3 mb-4 border-bottom bg-white">
        <div>
            <h1 class="h3 mb-0 text-gray-800">Advanced Features & Tools</h1>
            <p class="text-muted small mb-0">Global search, data export tools, and real-time audit logs.</p>
        </div>
        <div class="d-flex gap-2">
            <!-- Real Print / PDF Export Button -->
            <button class="btn btn-outline-primary btn-sm" onclick="printTableReport()">
                <i class="fas fa-print me-1"></i> Print / PDF
            </button>
            <!-- Real CSV Download Button -->
            <button class="btn btn-outline-success btn-sm" onclick="exportTableToCSV('activity_logs.csv')">
                <i class="fas fa-file-csv me-1"></i> Export CSV
            </button>
            <!-- Refresh Logs -->
            <button class="btn btn-outline-secondary btn-sm" onclick="window.location.reload();">
                <i class="fas fa-sync-alt me-1"></i> Refresh
            </button>
        </div>
    </div>

    <!-- 🔍 GLOBAL SEARCH & FILTER TOOL BAR -->
    <div class="card shadow-sm border-0 mb-4 p-3 bg-light">
        <div class="row align-items-center">
            <div class="col-md-8">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-muted"></i></span>
                    <input type="text" id="globalSearchInput" class="form-control border-start-0" placeholder="Global Search: Type user, action, or module to filter instantly..." onkeyup="filterTable()">
                </div>
            </div>
            <div class="col-md-4 text-md-end mt-2 mt-md-0">
                <span class="text-muted small"><i class="fas fa-info-circle me-1"></i> Instant live search active</span>
            </div>
        </div>
    </div>

    <!-- 2️⃣ TABLE WRAPPER -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 text-secondary fw-bold">System Activity Logs & Audit Trail</h5>
        </div>
        <div class="table-responsive sticky-table-wrap" style="max-height: 500px; overflow-y: auto;">
            <table class="table table-hover align-middle mb-0" id="logsTable">
                <!-- 3️⃣ THEAD -->
                <thead class="bg-light text-secondary text-uppercase fs-7 sticky-top" style="z-index: 1;">
                    <tr>
                        <th class="ps-4">#</th>
                        <th>User</th>
                        <th>Action</th>
                        <th>Module</th>
                        <th>Description</th>
                        <th>Timestamp</th>
                        <th class="pe-4">IP Address</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int index = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">@(index++)</td>
                                <td><span class="fw-bold text-dark">@item.UserName</span></td>
                                <td>
                                    <span class="badge @(item.ActionType == "Delete" ? "bg-danger" : item.ActionType == "Update" ? "bg-warning text-dark" : "bg-success")">
                                        @item.ActionType
                                    </span>
                                </td>
                                <td><span class="text-muted">@item.ModuleName</span></td>
                                <td>@item.Description</td>
                                <td>@item.Timestamp.ToString("dd MMM yyyy, hh:mm tt")</td>
                                <td class="pe-4 font-monospace text-muted small">@item.IpAddress</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <!-- 5️⃣ EMPTY STATE -->
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <div class="text-muted">
                                    <i class="fas fa-inbox fa-3x mb-3"></i>
                                    <p class="mb-0">No system activity logs found yet.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- JavaScript for Search, Print, and CSV Export -->
<script>
    // 1️⃣ Live Global Search Filter Function
    function filterTable() {
        var input, filter, table, tr, td, i, j, txtValue;
        input = document.getElementById("globalSearchInput");
        filter = input.value.toUpperCase();
        table = document.getElementById("logsTable");
        tr = table.getElementsByTagName("tr");

        for (i = 1; i < tr.length; i++) {
            tr[i].style.display = "none";
            td = tr[i].getElementsByTagName("td");
            for (j = 0; j < td.length; j++) {
                if (td[j]) {
                    txtValue = td[j].textContent || td[j].innerText;
                    if (txtValue.toUpperCase().indexOf(filter) > -1) {
                        tr[i].style.display = "";
                        break;
                    }
                }
            }
        }
    }

    // 2️⃣ Print Report Function
    function printTableReport() {
        window.print();
    }

    // 3️⃣ Export Table to CSV File Function
    function exportTableToCSV(filename) {
        var csv = [];
        var rows = document.querySelectorAll("#logsTable tr");

        for (var i = 0; i < rows.length; i++) {
            var row = [], cols = rows[i].querySelectorAll("td, th");
            for (var j = 0; j < cols.length; j++) {
                // Clean text and handle commas
                var data = cols[j].innerText.replace(/(\r\n|\n|\r)/gm, "").replace(/(\s\s)/gm, " ");
                row.push('"' + data + '"');
            }
            csv.push(row.join(","));
        }

        // Download CSV file
        var csvFile = new Blob([csv.join("\n")], { type: "text/csv" });
        var downloadLink = document.createElement("a");
        downloadLink.download = filename;
        downloadLink.href = window.URL.createObjectURL(csvFile);
        downloadLink.style.display = "none";
        document.body.appendChild(downloadLink);
        downloadLink.click();
        document.body.removeChild(downloadLink);
    }
</script>