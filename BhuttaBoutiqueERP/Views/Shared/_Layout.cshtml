<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bhutta Boutique ERP</title>

    <!-- Bootstrap 5 CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- FontAwesome CSS CDN -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">

    <!-- Global Custom site.css -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <!-- 1️⃣ TOP HEADER -->
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top px-3 enterprise-navbar">
        <div class="container-fluid">
            <!-- Brand Logo -->
            <a class="navbar-brand fw-bold d-flex align-items-center gap-2 text-white" href="/Home/Index">
                <div class="brand-icon-box"><i class="fa-solid fa-shirt"></i></div>
                <span>Bhutta Boutique</span>
            </a>

            <!-- Mobile Toggle Button -->
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Navbar Links: 5 Modules -->
            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-4 gap-2">
                    <li class="nav-item">
                        <a class="nav-link px-3 rounded-pill module-link text-white" href="#" data-module="Inventory">
                            <i class="fa-solid fa-boxes-stacked me-1"></i> Inventory
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 rounded-pill module-link text-white" href="#" data-module="Services">
                            <i class="fa-solid fa-concierge-bell me-1"></i> Services
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 rounded-pill module-link text-white" href="#" data-module="Production">
                            <i class="fa-solid fa-industry me-1"></i> Production
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 rounded-pill module-link text-white" href="#" data-module="HR">
                            <i class="fa-solid fa-users-gear me-1"></i> HR/Payroll
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 rounded-pill module-link text-white" href="#" data-module="Reports">
                            <i class="fa-solid fa-chart-pie me-1"></i> Reports
                        </a>
                    </li>
                </ul>

                <!-- User Profile & Logout -->
                <ul class="navbar-nav ms-auto align-items-center gap-3">
                    <li class="nav-item text-white small user-badge px-3 py-1 rounded-pill" style="background: rgba(255, 255, 255, 0.1);">
                        <i class="fa-solid fa-user-shield me-1"></i> <span>@(Context.Session.GetString("UserEmail") ?? "admin@bhuttaboutique.com")</span>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-sm px-3 rounded-pill fw-semibold text-white" asp-controller="Auth" asp-action="Logout" style="background: rgba(239, 68, 68, 0.25); border: 1px solid rgba(239, 68, 68, 0.4); transition: all 0.2s;" onmouseover="this.style.background='rgba(239, 68, 68, 0.45)'" onmouseout="this.style.background='rgba(239, 68, 68, 0.25)'">
                            <i class="fa-solid fa-right-from-bracket me-1"></i> Logout
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- 2️⃣ SUB-HEADER STRIP (Dynamic - site.js populates this) -->
    <div id="subheader-container" class="enterprise-subheader px-4 py-2">
        <ul class="nav nav-pills gap-2 overflow-auto flex-nowrap" id="sub-menu-list">
            <!-- Yahan site.js khud URL dekh kar features render karega -->
        </ul>
    </div>

    <!-- 3️⃣ MAIN CONTENT CONTAINER -->
    <main class="container-fluid py-4 px-4" id="main-content" style="min-height: 80vh;">
        @RenderBody()
    </main>

    <!-- 4️⃣ GLOBAL MODAL CONTAINER -->
    <div class="modal fade" id="globalModal" tabindex="-1" aria-labelledby="globalModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content shadow-lg border-0 rounded-4" id="modal-content-body">
                <!-- Dynamic AJAX Form Content Loads Here -->
            </div>
        </div>
    </div>
    <!-- 5️⃣ GLOBAL TOAST CONTAINER -->
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1080;" id="toastContainer"></div>

    <!-- 🚫 Professional Access Denied Modal -->
    <div id="accessDeniedModal" class="access-denied-modal">
        <div class="access-denied-box">
            <div class="access-denied-icon">🔒</div>
            <h3>Access Denied</h3>
            <p>You do not have permission to access this module/feature with your current role.</p>
            <button onclick="closeAccessDeniedModal()" class="access-denied-btn">OK, Got It</button>
        </div>
    </div>

    <!-- SCRIPTS -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <script>
        function showAccessDeniedModal() {
        document.getElementById('accessDeniedModal').style.display = 'flex';
        }
        function closeAccessDeniedModal() {
        document.getElementById('accessDeniedModal').style.display = 'none';
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
    <script>
        var currentUserRole = '@(Context.Session.GetString("UserRole") ?? "Admin")';

        $(document).ready(function () {

        // 1. TOP MODULE CLICK CHECK (direct bind — .module-link static hai, kabhi replace nahi hota)
        $('.module-link').on('click', function (e) {
        if (currentUserRole === 'Admin') return;

        var clickedModule = $(this).data('module');
        if (!isModuleAllowed(currentUserRole, clickedModule)) {
        e.preventDefault();
        e.stopImmediatePropagation(); // site.js ka highlight handler bhi rok do
        showAccessDeniedModal();
        return false;
        }
        });

        // 2. SUB-HEADER FEATURE CLICK CHECK
        // ✅ FIX: Delegated binding (document par) — kyunki #sub-menu-list ke
        // <a> tags site.js ke renderSubMenu() se BAAR BAAR replace hote hain.
        // Direct binding sirf pehli render ke liye kaam karti, uske baad
        // naye <a> tags par ye check silently miss ho jaata.
        $(document).on('click', '#sub-menu-list a', function (e) {
        if (currentUserRole === 'Admin') return;

        var clickedUrl = $(this).attr('data-url') || '';
        var clickedModule = '';

        if (clickedUrl.includes('/Inventory/')) clickedModule = 'Inventory';
        else if (clickedUrl.includes('/Services/')) clickedModule = 'Services';
        else if (clickedUrl.includes('/Production/')) clickedModule = 'Production';
        else if (clickedUrl.includes('/HR/')) clickedModule = 'HR';
        else if (clickedUrl.includes('/Reports/')) clickedModule = 'Reports';

        if (!isModuleAllowed(currentUserRole, clickedModule)) {
        e.preventDefault();
        e.stopImmediatePropagation();
        showAccessDeniedModal();
        return false;
        }
        });

        // 3. ✅ NEW: HOME QUICK-ACCESS CARD CLICK CHECK
        // Home/Index.cshtml ke .quick-access-card bhi isi tarah role-check honge.
        // site.js ka .quick-access-card handler navigation karta hai —
        // yahan hum sirf UNAUTHORIZED case ko rok ke popup dikhate hain.
        $(document).on('click', '.quick-access-card', function (e) {
        if (currentUserRole === 'Admin') return;

        var clickedModule = $(this).data('module');
        if (!isModuleAllowed(currentUserRole, clickedModule)) {
        e.preventDefault();
        e.stopImmediatePropagation(); // site.js ka navigation handler rok do
        showAccessDeniedModal();
        return false;
        }
        });
        });

        // Helper: Role check function
        function isModuleAllowed(role, moduleName) {
        if (role === 'Admin') return true;
        if (role === 'InventoryManager' && moduleName === 'Inventory') return true;
        if (role === 'ProductionSupervisor' && moduleName === 'Production') return true;
        if (role === 'BookingClerk' && (moduleName === 'Services' || moduleName === 'Inventory')) return true;
        if (role === 'HRManager' && moduleName === 'HR') return true;
        return false;
        }
    </script>
</body>
</html>