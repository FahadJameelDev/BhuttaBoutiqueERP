@model BhuttaBoutiqueERP.Models.HR.Entities.Attendance

<div class="modal-dialog">
    <div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title fw-bold">Edit Attendance</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form asp-action="Edit" method="post" id="modalForm" class="ajax-form">
            <input type="hidden" asp-for="Id" />
            <div class="modal-body">
                <div class="mb-3">
                    <label asp-for="EmployeeId" class="form-label fw-semibold">Employee</label>
                    <select asp-for="EmployeeId" class="form-select" asp-items="ViewBag.Employees">
                        <option value="">-- Select Employee --</option>
                    </select>
                    <span asp-validation-for="EmployeeId" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Date" class="form-label fw-semibold">Date</label>
                    <input asp-for="Date" type="date" class="form-control" />
                    <span asp-validation-for="Date" class="text-danger small"></span>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="CheckIn" class="form-label fw-semibold">Check In</label>
                        <input asp-for="CheckIn" type="time" class="form-control" />
                        <span asp-validation-for="CheckIn" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="CheckOut" class="form-label fw-semibold">Check Out</label>
                        <input asp-for="CheckOut" type="time" class="form-control" />
                        <span asp-validation-for="CheckOut" class="text-danger small"></span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Status" class="form-label fw-semibold">Status</label>
                        <select asp-for="Status" class="form-select">
                            <option value="Present">Present</option>
                            <option value="Absent">Absent</option>
                            <option value="HalfDay">HalfDay</option>
                            <option value="Leave">Leave</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="LateMinutes" class="form-label fw-semibold">Late Minutes</label>
                        <input asp-for="LateMinutes" type="number" class="form-control" />
                        <span asp-validation-for="LateMinutes" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="OvertimeHours" class="form-label fw-semibold">Overtime Hours</label>
                        <input asp-for="OvertimeHours" type="number" step="0.1" class="form-control" />
                        <span asp-validation-for="OvertimeHours" class="text-danger small"></span>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary">Update Changes</button>
            </div>
        </form>
    </div>
</div>