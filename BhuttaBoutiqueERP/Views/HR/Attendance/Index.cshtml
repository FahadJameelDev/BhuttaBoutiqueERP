@model IEnumerable<BhuttaBoutiqueERP.Models.HR.Entities.Attendance>

@{
    ViewData["Title"] = "Attendance Management";
}

<!-- 1️⃣ HEADER STRIP -->
<div class="sticky-header-strip d-flex justify-content-between align-items-center px-4 py-3 bg-white border-bottom shadow-sm">
    <div>
        <h4 class="mb-1 text-dark fw-bold">Attendance Records</h4>
        <p class="text-muted mb-0 small">Manage daily employee shifts, check-ins, lateness, and overtime.</p>
    </div>
    <div>
        <button type="button" class="btn btn-primary open-modal-btn" data-url="@Url.Action("Create", "Attendance")">
            <i class="fas fa-plus me-1"></i> Mark Attendance
        </button>
    </div>
</div>

<div class="container-fluid px-4 mt-4">
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <!-- 2️⃣ TABLE WRAPPER -->
            <div class="table-responsive sticky-table-wrap">
                <table class="table table-hover align-middle mb-0">
                    <!-- 3️⃣ THEAD -->
                    <thead class="bg-light text-secondary text-uppercase fs-7">
                        <tr>
                            <th class="ps-4">Employee</th>
                            <th>Date</th>
                            <th>Check In</th>
                            <th>Check Out</th>
                            <th>Status</th>
                            <th>Late (Mins)</th>
                            <th>Overtime (Hrs)</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold text-dark">@item.Employee?.FullName</td>
                                    <td>@item.Date.ToString("yyyy-MM-dd")</td>
                                    <td>@(item.CheckIn.HasValue? item.CheckIn.Value.ToString(@"hh\:mm") : "-")</td>
                                    <td>@(item.CheckOut.HasValue? item.CheckOut.Value.ToString(@"hh\:mm") : "-")</td>
                                    <td>
                                        <span class="badge @(item.Status == "Present" ? "bg-success" : item.Status == "Absent" ? "bg-danger" : "bg-warning text-dark")">
                                            @item.Status
                                        </span>
                                    </td>
                                    <td>@item.LateMinutes</td>
                                    <td>@item.OvertimeHours</td>
                                    <td class="text-end pe-4">
                                        <!-- 4️⃣ BUTTONS (Edit, Delete) -->
                                        <button type="button" class="btn btn-sm btn-outline-primary open-modal-btn me-1" data-url="@Url.Action("Edit", "Attendance", new { id = item.Id })">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-danger open-modal-btn" data-url="@Url.Action("Delete", "Attendance", new { id = item.Id })">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <!-- 5️⃣ EMPTY STATE -->
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="fas fa-inbox fa-3x mb-3 text-secondary"></i>
                                    <p class="mb-0 fw-semibold">No attendance records found.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>