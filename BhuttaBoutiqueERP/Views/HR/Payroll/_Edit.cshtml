@model BhuttaBoutiqueERP.Models.HR.Entities.Payroll

<div class="modal-dialog modal-lg">
    <div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title fw-bold">Edit Payroll</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form asp-action="Edit" method="post" id="modalForm" class="ajax-form">
            <input type="hidden" asp-for="Id" />
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="EmployeeId" class="form-label fw-semibold">Employee</label>
                        <select asp-for="EmployeeId" class="form-select" asp-items="ViewBag.Employees">
                            <option value="">-- Select Employee --</option>
                        </select>
                        <span asp-validation-for="EmployeeId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Month" class="form-label fw-semibold">Month</label>
                        <input asp-for="Month" type="text" class="form-control" />
                        <span asp-validation-for="Month" class="text-danger small"></span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="BaseSalary" class="form-label fw-semibold">Base Salary</label>
                        <input asp-for="BaseSalary" type="number" step="0.01" class="form-control" />
                        <span asp-validation-for="BaseSalary" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Commission" class="form-label fw-semibold">Commission</label>
                        <input asp-for="Commission" type="number" step="0.01" class="form-control" />
                        <span asp-validation-for="Commission" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Overtime" class="form-label fw-semibold">Overtime Pay</label>
                        <input asp-for="Overtime" type="number" step="0.01" class="form-control" />
                        <span asp-validation-for="Overtime" class="text-danger small"></span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Bonus" class="form-label fw-semibold">Bonus</label>
                        <input asp-for="Bonus" type="number" step="0.01" class="form-control" />
                        <span asp-validation-for="Bonus" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Deductions" class="form-label fw-semibold">Deductions</label>
                        <input asp-for="Deductions" type="number" step="0.01" class="form-control" />
                        <span asp-validation-for="Deductions" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Status" class="form-label fw-semibold">Status</label>
                        <select asp-for="Status" class="form-select">
                            <option value="Pending">Pending</option>
                            <option value="Paid">Paid</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary">Update Changes</button>
            </div>
        </form>
    </div>
</div>