@model BhuttaBoutiqueERP.Models.HR.Entities.CommissionRate

<div class="modal-dialog">
    <div class="modal-content">
        <div class="modal-header bg-light">
            <h5 class="modal-title text-dark fw-bold" style="font-size: 16px;">
                <i class="fas fa-plus-circle me-2 text-primary"></i>New Commission Rate
            </h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <form asp-action="Create" method="post" class="ajax-form">
            <div class="modal-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="ServiceId" class="form-label">Service</label>
                        <select asp-for="ServiceId" class="form-select" asp-items="@(new SelectList(ViewBag.Services, "Id", "Name"))">
                            <option value="">-- Select Service --</option>
                        </select>
                        <span asp-validation-for="ServiceId" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Complexity" class="form-label">Complexity Level</label>
                        <select asp-for="Complexity" class="form-select">
                            <option value="">-- Select Complexity --</option>
                            <option value="Simple">Simple</option>
                            <option value="Medium">Medium</option>
                            <option value="Complex">Complex</option>
                            <option value="Heavy Embroidery">Heavy Embroidery</option>
                        </select>
                        <span asp-validation-for="Complexity" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Rate" class="form-label">Rate (PKR)</label>
                        <input asp-for="Rate" class="form-control" type="number" step="0.01" placeholder="0.00" />
                        <span asp-validation-for="Rate" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Status" class="form-label"></label>
                        <select asp-for="Status" class="form-select">
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary px-4 fw-semibold">
                    <i class="fas fa-save me-1"></i> Save Rate
                </button>
            </div>
        </form>
    </div>
</div>