@model IEnumerable<BhuttaBoutiqueERP.Models.Inventory.Entities.Item>

@{
    ViewData["Title"] = "Low Stock Alert";
}

<!-- Sticky Module Identity Header -->
<div class="sticky-header-strip d-flex justify-content-between align-items-center">
    <div>
        <h2 class="text-dark fw-bold mb-1" style="font-size: 20px;">
            <i class="fas fa-exclamation-triangle me-2 text-warning"></i>Low Stock Alert
        </h2>
        <p class="text-secondary mb-0" style="font-size: 12.5px;">Items reaching or falling below their designated reorder threshold.</p>
    </div>
    <a href="/Inventory/Items" class="btn btn-outline-secondary px-3 py-2 shadow-sm" style="font-weight: 600; border-radius: 8px;">
        <i class="fas fa-arrow-left me-1"></i> Back to Items
    </a>
</div>

<!-- Table Card with Guaranteed Internal Scroller and Sticky Header -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
    <div style="max-height: 520px; overflow-y: auto; position: relative;">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th class="ps-4 text-white py-3" style="background-color: #dc3545; position: sticky; top: 0; z-index: 10;">Item Code</th>
                    <th class="text-white py-3" style="background-color: #dc3545; position: sticky; top: 0; z-index: 10;">Name</th>
                    <th class="text-white py-3" style="background-color: #dc3545; position: sticky; top: 0; z-index: 10;">Category</th>
                    <th class="text-white py-3" style="background-color: #dc3545; position: sticky; top: 0; z-index: 10;">Current Stock</th>
                    <th class="text-white py-3" style="background-color: #dc3545; position: sticky; top: 0; z-index: 10;">Reorder Level</th>
                    <th class="pe-4 text-white py-3" style="background-color: #dc3545; position: sticky; top: 0; z-index: 10;">Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4"><span class="fw-bold text-danger">@item.Code</span></td>
                            <td class="fw-semibold">@item.Name</td>
                            <td><span class="badge bg-light text-dark border">@item.Category</span></td>
                            <td><span class="badge bg-danger text-white rounded-pill px-3">@item.Stock.ToString("0.##")</span></td>
                            <td class="fw-medium">@item.ReorderLevel.ToString("0.##")</td>
                            <td class="pe-4"><span class="badge bg-warning-subtle text-dark border border-warning-subtle rounded-pill px-2">Reorder Required</span></td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-success fw-bold py-5">
                            <i class="fas fa-check-circle fa-3x d-block mb-2 text-success opacity-75"></i>
                            All items have sufficient stock! No low stock alerts.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>