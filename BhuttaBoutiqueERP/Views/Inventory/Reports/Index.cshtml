@model IEnumerable<BhuttaBoutiqueERP.Models.Inventory.Entities.Item>

@{
    ViewData["Title"] = "Stock Reports";
}

<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="card-body d-flex justify-content-between align-items-center p-4 bg-white">
        <div>
            <h3 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                <i class="fas fa-chart-bar text-success"></i> Stock Reports
            </h3>
            <p class="text-secondary small mb-0">Comprehensive inventory valuation and stock summary matrix.</p>
        </div>
        <a href="/Inventory/Items" class="btn btn-outline-secondary px-4 rounded-pill shadow-sm">
            <i class="fas fa-arrow-left me-1"></i> Back to Items
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive" style="max-height: 580px; overflow-y: auto;">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-success text-white text-uppercase fs-7" style="position: sticky; top: 0; z-index: 10;">
                <tr>
                    <th class="ps-4">Code</th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Stock</th>
                    <th>Price</th>
                    <th>Unit</th>
                    <th class="pe-4">Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4"><span class="fw-bold text-success">@item.Code</span></td>
                            <td class="fw-semibold">@item.Name</td>
                            <td><span class="badge bg-light text-dark border">@item.Category</span></td>
                            <td><strong class="text-dark">@item.Stock.ToString("0.##")</strong></td>
                            <td class="fw-semibold">@item.Price.ToString("N0") PKR</td>
                            <td>@item.Unit</td>
                            <td class="pe-4">
                                <span class="badge @(item.Status == "Active" ? "bg-success-subtle text-success border border-success-subtle" : "bg-secondary-subtle text-secondary") rounded-pill px-2">
                                    @item.Status
                                </span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-5">
                            <i class="fas fa-folder-open fa-3x d-block mb-2 opacity-25"></i>
                            No inventory records found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>