@model IEnumerable<BhuttaBoutiqueERP.Models.Inventory.Entities.StockIn>

@{
    ViewData["Title"] = "Stock In";
}

<!-- Sticky Header Strip with Professional Spacing -->
<div class="sticky-header-strip d-flex justify-content-between align-items-center">
    <div>
        <h2 class="text-dark fw-bold mb-1" style="font-size: 20px;">
            <i class="fas fa-arrow-down me-2 text-success"></i>Stock In (GRN)
        </h2>
        <p class="text-secondary mb-0" style="font-size: 12.5px;">Manage goods receipt notes and incoming inventory stock efficiently.</p>
    </div>
    <!-- AJAX Modal Trigger Button -->
    <button type="button" class="btn btn-success px-3 py-2 shadow-sm open-modal-btn" data-url="@Url.Action("Create")" style="font-weight: 600; border-radius: 8px;">
        <i class="fas fa-plus me-1"></i> New Stock In
    </button>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="sticky-table-wrap">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Item</th>
                        <th>Supplier</th>
                        <th>Quantity</th>
                        <th>Price</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>@item.Item?.Name</strong></td>
                                <td>@item.Supplier?.Name</td>
                                <td>@item.Quantity.ToString("0.##")</td>
                                <td>@item.Price.ToString("N0") PKR</td>
                                <td>@item.Date.ToString("dd MMM yyyy")</td>
                                <td>
                                    <span class="badge @(item.Status == "Completed" ? "bg-success" : "bg-warning text-dark") px-2 py-1">
                                        @item.Status
                                    </span>
                                </td>
                                <td class="text-end">
                                    <!-- AJAX Modal Delete Trigger Button -->
                                    <button type="button" class="btn btn-sm btn-outline-danger open-modal-btn" data-url="@Url.Action("Delete", new { id = item.Id })" title="Delete Record">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-5">
                                <i class="fas fa-inbox fa-2x d-block mb-2 opacity-50"></i>
                                <p class="mb-0">No stock in records found</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>