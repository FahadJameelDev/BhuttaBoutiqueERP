@model IEnumerable<BhuttaBoutiqueERP.Models.Inventory.Entities.Supplier>

@{
    ViewData["Title"] = "Suppliers";
}

<!-- Sticky Header Strip with Professional Spacing -->
<div class="sticky-header-strip d-flex justify-content-between align-items-center">
    <div>
        <h2 class="text-dark fw-bold mb-1" style="font-size: 20px;">
            <i class="fas fa-truck me-2 text-primary"></i>Suppliers
        </h2>
        <p class="text-secondary mb-0" style="font-size: 12.5px;">Manage vendor profiles, contact details, and status.</p>
    </div>
    <!-- AJAX Modal Trigger Button -->
    <button type="button" class="btn btn-primary px-3 py-2 shadow-sm open-modal-btn" data-url="@Url.Action("Create")" style="font-weight: 600; border-radius: 8px;">
        <i class="fas fa-plus me-1"></i> Add Supplier
    </button>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="sticky-table-wrap">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Contact</th>
                        <th>Email</th>
                        <th>Address</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td><strong class="text-dark">@item.Name</strong></td>
                                <td>@item.Contact</td>
                                <td>@item.Email</td>
                                <td>@item.Address</td>
                                <td>
                                    <span class="badge @(item.Status == "Active" ? "bg-success" : "bg-secondary") px-2 py-1">
                                        @item.Status
                                    </span>
                                </td>
                                <td class="text-end">
                                    <!-- AJAX Modal Edit Trigger Button -->
                                    <button type="button" class="btn btn-sm btn-outline-primary me-1 open-modal-btn" data-url="@Url.Action("Edit", new { id = item.Id })" title="Edit Supplier">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <!-- AJAX Modal Delete Trigger Button -->
                                    <button type="button" class="btn btn-sm btn-outline-danger open-modal-btn" data-url="@Url.Action("Delete", new { id = item.Id })" title="Delete Supplier">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-5">
                                <i class="fas fa-inbox fa-2x d-block mb-2 opacity-50"></i>
                                <p class="mb-0">No suppliers found</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>