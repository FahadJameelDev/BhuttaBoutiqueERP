@model IEnumerable<BhuttaBoutiqueERP.Models.Inventory.Entities.Item>

@{
    ViewData["Title"] = "Items";
}

<!-- 🌟 Sticky Header Strip (Title + Create Button stays fixed while scrolling) -->
<div class="sticky-header-strip">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h3 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                <i class="fas fa-boxes text-success"></i> Item Master
            </h3>
            <p class="text-secondary small mb-0">Manage inventory items, stock levels, and pricing matrix.</p>
        </div>
        <button type="button" class="btn btn-success px-4 rounded-pill shadow-sm open-modal-btn" data-url="/Inventory/Items/Create">
            <i class="fas fa-plus me-1"></i> Create New Item
        </button>
    </div>
</div>

<!-- Main Content Card with Sticky Table Scroll -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive sticky-table-wrap">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary text-uppercase fs-7">
                    <tr>
                        <th class="ps-4">Code</th>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Stock</th>
                        <th>Price</th>
                        <th>Unit</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            var isLowStock = item.Stock <= item.ReorderLevel;
                            <tr>
                                <td class="ps-4"><span class="fw-bold text-success">@item.Code</span></td>
                                <td class="fw-semibold">@item.Name</td>
                                <td><span class="badge bg-light text-dark border">@item.Category</span></td>
                                <td>
                                    <span class="@(isLowStock ? "text-danger fw-bold" : "text-dark fw-medium")">
                                        @item.Stock.ToString("0.##")
                                    </span>
                                    @if (isLowStock)
                                    {
                                        <span class="badge bg-danger text-white ms-1 rounded-pill px-2" style="font-size: 10px;">Low Stock</span>
                                    }
                                </td>
                                <td class="fw-semibold">@item.Price.ToString("N0") PKR</td>
                                <td>@item.Unit</td>
                                <td>
                                    <span class="badge @(item.Status == "Active" ? "bg-success-subtle text-success border border-success-subtle" : "bg-secondary-subtle text-secondary") rounded-pill px-2">
                                        @item.Status
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <button type="button" class="btn btn-sm btn-light text-primary border me-1 open-modal-btn" data-url="/Inventory/Items/Edit/@item.Id" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <!-- Safe Modal Trigger for Delete -->
                                    <button type="button" class="btn btn-sm btn-light text-danger border open-modal-btn" data-url="/Inventory/Items/Delete/@item.Id" title="Delete">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-5">
                                <i class="fas fa-inbox fa-3x d-block mb-2 opacity-25"></i>
                                <p class="mb-0 fw-medium">No inventory items found in the database.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="mt-4 d-flex gap-2">
    <a href="/Inventory/LowStock" class="nav-link btn btn-outline-warning text-dark border px-3 rounded-pill fw-semibold shadow-sm">
        <i class="fas fa-exclamation-triangle me-1 text-warning"></i> View Low Stock Items
    </a>
</div>