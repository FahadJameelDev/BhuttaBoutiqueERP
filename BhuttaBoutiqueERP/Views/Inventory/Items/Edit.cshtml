@model BhuttaBoutiqueERP.Models.Inventory.ViewModels.ItemViewModel

@{
    ViewData["Title"] = "Edit Item";
}

<div class="modal-header bg-success text-white border-0 py-3 px-4 rounded-top-4">
    <h5 class="modal-title fw-bold d-flex align-items-center gap-2">
        <i class="fas fa-edit"></i> Edit Item Record
    </h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="ajax-form">
    <div class="modal-body px-4 py-3">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 p-2 small" role="alert"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Code" class="form-label"></label>
                <input asp-for="Code" class="form-control" />
                <span asp-validation-for="Code" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Category" class="form-label"></label>
                <input asp-for="Category" class="form-control" />
                <span asp-validation-for="Category" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Unit" class="form-label"></label>
                <input asp-for="Unit" class="form-control" />
                <span asp-validation-for="Unit" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Stock" class="form-label"></label>
                <input asp-for="Stock" class="form-control" type="number" step="0.01" readonly />
                <span asp-validation-for="Stock" class="text-danger small"></span>
                <small class="text-muted d-block mt-1">Stock is auto-managed</small>
            </div>
            <div class="col-md-4">
                <label asp-for="Price" class="form-label"></label>
                <input asp-for="Price" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="Price" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="ReorderLevel" class="form-label"></label>
                <input asp-for="ReorderLevel" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="ReorderLevel" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" class="form-select">
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                </select>
                <span asp-validation-for="Status" class="text-danger small"></span>
            </div>
        </div>
    </div>

    <div class="modal-footer bg-light border-0 py-3 px-4 rounded-bottom-4">
        <button type="button" class="btn btn-secondary px-4 rounded-pill" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-success px-4 rounded-pill shadow-sm">
            <i class="fas fa-save me-1"></i> Update Changes
        </button>
    </div>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}