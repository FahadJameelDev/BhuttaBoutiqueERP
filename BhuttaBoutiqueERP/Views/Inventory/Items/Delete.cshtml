@model BhuttaBoutiqueERP.Models.Inventory.Entities.Item

@{
    Layout = null;
}

<form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post" id="modalForm" class="ajax-form">
    @Html.AntiForgeryToken()

    <div class="modal-header bg-danger text-white">
        <h5 class="modal-title"><i class="fas fa-exclamation-triangle me-2"></i> Confirm Delete</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body">
        <p class="text-secondary">Are you sure you want to delete the following item? This action cannot be undone.</p>
        
        <div class="card bg-light border-0 p-3 rounded-3 mb-3">
            <div class="row mb-2">
                <div class="col-4 fw-bold text-muted">Item Code:</div>
                <div class="col-8 text-dark fw-semibold">@Model.Code</div>
            </div>
            <div class="row mb-2">
                <div class="col-4 fw-bold text-muted">Item Name:</div>
                <div class="col-8 text-dark fw-semibold">@Model.Name</div>
            </div>
            <div class="row mb-2">
                <div class="col-4 fw-bold text-muted">Category:</div>
                <div class="col-8 text-dark">@Model.Category</div>
            </div>
            <div class="row">
                <div class="col-4 fw-bold text-muted">Current Stock:</div>
                <div class="col-8 text-dark">@Model.Stock.ToString("0.##") @Model.Unit</div>
            </div>
        </div>
    </div>

    <div class="modal-footer bg-light">
        <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-danger rounded-pill px-4 shadow-sm">
            <i class="fas fa-trash me-1"></i> Yes, Delete
        </button>
    </div>
</form>