@model BhuttaBoutiqueERP.Models.Inventory.Entities.StockReturn

<div class="modal-dialog">
    <div class="modal-content">
        <div class="modal-header bg-light">
            <h5 class="modal-title text-danger fw-bold" style="font-size: 16px;">
                <i class="fas fa-trash me-2"></i>Delete Stock Return Record
            </h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <form asp-action="Delete" method="post" class="ajax-form">
            <input type="hidden" asp-for="Id" />
            
            <div class="modal-body">
                <p class="mb-2">Are you sure you want to delete this stock return record?</p>
                <div class="p-3 bg-light rounded border">
                    <div class="mb-1"><strong>Item:</strong> @Model.Item?.Name</div>
                    <div class="mb-1"><strong>Quantity:</strong> @Model.Quantity.ToString("0.##")</div>
                    <div><strong>Date:</strong> @Model.Date.ToString("dd MMM yyyy")</div>
                </div>
            </div>

            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-danger px-4" style="font-weight: 600;">
                    <i class="fas fa-trash me-1"></i> Confirm Delete
                </button>
            </div>
        </form>
    </div>
</div>